
model Projeto {
    id          String   @id @default(uuid())
    title       String
    desc        String
    about       String
    concluido   Boolean
    impressoes  Int @default(0)
    impressoesProjeto Int @default(0)
    impressoesCodigo  Int @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    tec ProjetoTecnologia[]
    linkProjeto String
    linkRepo    String
    imgUrl      String
}

    